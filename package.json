{
  "name": "qa-control",
  "description": "QA control of things that nobody controls",
  "version": "0.6.6",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": "codenautas/qa-control",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    },
    {
      "name": "Diego Florio",
      "email": "diegoefe@gmail.com"
    }
  ],
  "bin": {
    "qa-control": "./bin/qa-control-run.js"
  },
  "main": "./bin/qa-control.js",
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0"
  },
  "dependencies": {
    "best-globals": "^2.1.5",
    "commander": "^14.0.3",
    "eslint": "^10.4.0",
    "fs-extra": "^11.3.5",
    "js-yaml": "^4.1.1",
    "multilang": "^1.2.1",
    "semver": "^7.8.0",
    "strip-bom-string": "^1.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.0",
    "expect-called": "^0.4.0",
    "expect.js": "^0.3.1",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "sinon": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "test": "mocha --reporter spec  --check-leaks test/",
    "test-nc": "mocha --reporter spec --bail --check-leaks --no-colors test/",
    "test-ci": "nyc --reporter=lcov mocha --reporter spec --check-leaks test/",
    "test-cov": "nyc mocha --reporter dot --check-leaks test/",
    "start": "node ./bin/qa-control-run.js",
    "report": "nyc report",
    "qac": "node bin/qa-control-run.js . -v",
    "typecheck": "tsc",
    "all": "npm test && npm run test-cov && npm run report && npm run qac"
  },
  "files": [
    "bin"
  ],
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "cmd-tool",
    "ecmaVersion": 6
  }
}
