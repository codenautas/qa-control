{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2015",
    "module": "commonjs",
    "moduleResolution": "node10",
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["mocha", "node"]
  },
  "include": [
    "declarations.d.ts",
    "bin/**/*.js",
    "test/test.js",
    "test/test.helper.js"
  ]
}
